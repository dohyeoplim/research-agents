{
    "display_information": {
        "name": "Research Agent",
        "description": "Literature research and report writing",
        "background_color": "#141414"
    },
    "features": {
        "agent_view": {
            "suggested_prompts": []
        },
        "bot_user": {
            "display_name": "Research Agent",
            "always_online": false
        }
    },
    "oauth_config": {
        "scopes": {
            "bot": [
                "app_mentions:read",
                "assistant:write",
                "chat:write",
                "chat:write.customize",
                "channels:history",
                "channels:read",
                "groups:read",
                "files:read",
                "files:write",
                "bookmarks:read",
                "bookmarks:write",
                "canvases:read",
                "canvases:write",
                "groups:history"
            ]
        },
        "pkce_enabled": false
    },
    "settings": {
        "interactivity": {
            "is_enabled": true
        },
        "org_deploy_enabled": false,
        "token_rotation_enabled": false,
        "app_level_token_rotation_enabled": false,
        "socket_mode_enabled": true,
        "event_subscriptions": {
            "bot_events": [
                "app_mention",
                "message.channels",
                "message.groups",
                "agent_session_title_changed"
            ]
        }
    }
}
